{
  "name": "desktop",
  "productName": "Jarvis",
  "description": "Jarvis, tu asistente de voz",
  "desktopName": "Jarvis.desktop",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev:app": "tsc -p tsconfig.build.json && electron .",
    "package": "node scripts/stage-server.mjs && electron-builder --linux AppImage",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10",
    "globals": "^17.13.0",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "dbus-next": "0.10.2"
  }
}
